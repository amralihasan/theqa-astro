---
import type { Post } from '../types/Post';

export interface Props {
  post: Post;
}

const { post } = Astro.props;

function formatDate(date: Date): string {
  return date.toLocaleDateString('ar-SA', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<article class="post-card">
  <div class="post-card-content">
    <h2 class="post-title">
      <a href={`/posts/${post.slug}`}>{post.title}</a>
    </h2>
    
    <time class="post-date" datetime={post.publishedAt.toISOString()}>
      {formatDate(post.publishedAt)}
    </time>
    
    {post.excerpt && (
      <p class="post-excerpt">{post.excerpt}</p>
    )}
    
    <a href={`/posts/${post.slug}`} class="read-more">
      ← اقرأ المزيد
    </a>
  </div>
</article>

<style>
  .post-card {
    background: white;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    overflow: hidden;
  }

  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .post-card-content {
    padding: 1.5rem;
  }

  .post-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .post-title a {
    color: #333;
    text-decoration: none;
  }

  .post-title a:hover {
    color: #0066cc;
  }

  .post-date {
    color: #666;
    font-size: 0.875rem;
    display: block;
    margin-bottom: 1rem;
  }

  .post-excerpt {
    color: #555;
    line-height: 1.5;
    margin: 0 0 1rem 0;
  }

  .read-more {
    color: #0066cc;
    font-weight: 500;
    font-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .read-more:hover {
    text-decoration: none;
    color: #0052a3;
  }
</style>