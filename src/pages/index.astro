---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getAllPosts } from '../data/posts';

const posts = await getAllPosts();
---

<BaseLayout title="مدونة الاستثمار - دليلك للاستثمار الذكي" description="اكتشف أفضل استراتيجيات الاستثمار واختيار الوسطاء الماليين وإدارة المخاطر في الأسواق المالية.">
  <div class="hero">
    <h1>أهلاً بك في مدونة الاستثمار</h1>
    <p>دليلك الشامل للاستثمار الذكي والوساطة المالية</p>
  </div>

  <section class="posts-section">
    <h2 class="section-title">أحدث المقالات الاستثمارية</h2>
    <div class="posts-grid">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3rem 0;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-radius: 12px;
    margin-bottom: 3rem;
  }

  .hero h1 {
    font-size: 3rem;
    margin: 0 0 1rem 0;
    font-weight: 700;
  }

  .hero p {
    font-size: 1.25rem;
    margin: 0;
    opacity: 0.9;
  }

  .posts-section {
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: #333;
    font-weight: 600;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2rem 1rem;
      margin-bottom: 2rem;
    }

    .hero h1 {
      font-size: 2rem;
    }

    .hero p {
      font-size: 1rem;
    }

    .posts-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
